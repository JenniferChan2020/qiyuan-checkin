page {
  --green: #6B8E7B;
  --green-dark: #4F7160;
  --pink: #D98C8C;
  --bg: #F5F0EB;
  --card: #FFFFFF;
  --text: #333333;
  --text-sub: #888888;
  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 24rpx;
  padding-bottom: 140rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text);
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.btn-primary {
  background: var(--green);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--green-dark);
  margin: 8rpx 0 16rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 30rpx;
  background: var(--green);
  border-radius: 6rpx;
  margin-right: 14rpx;
}
