.day-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.day-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-right: 16rpx;
  min-width: 110rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.day-active {
  background: var(--green);
  color: #fff;
}
.day-emoji { font-size: 36rpx; }
.day-name { font-size: 26rpx; margin-top: 6rpx; }

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.detail-day {
  font-size: 34rpx;
  font-weight: bold;
  margin-right: 16rpx;
}
.type-tag {
  font-size: 24rpx;
  color: var(--green-dark);
  background: #EAF3EE;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.detail-desc {
  font-size: 28rpx;
  color: var(--text);
  margin-bottom: 8rpx;
}
.detail-meta {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.phase {
  margin-bottom: 24rpx;
}
.phase-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--green-dark);
  margin-bottom: 12rpx;
}
.phase-item {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
  padding-left: 12rpx;
}
.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
  background: #F5F0EB;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}
