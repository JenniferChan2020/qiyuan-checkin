<view class="container">
  <view class="title">🍱 本周食谱</view>
  <view class="subtitle">补气血 · 抗糖 · 健脑，专为36岁的你设计</view>

  <!-- 周几切换 -->
  <scroll-view scroll-x class="day-scroll">
    <view
      wx:for="{{recipes}}" wx:key="day"
      class="day-tab {{activeDay === index ? 'day-active' : ''}}"
      bindtap="switchDay"
      data-idx="{{index}}"
    >
      <text class="day-emoji">{{item.emoji}}</text>
      <text class="day-name">{{item.day}}</text>
    </view>
  </scroll-view>

  <!-- 当日详情 -->
  <view class="card day-detail" wx:for="{{[recipes[activeDay]]}}" wx:key="day">
    <view class="detail-header">
      <text class="detail-day">{{item.day}} {{item.emoji}}</text>
      <text class="detail-theme">{{item.theme}}</text>
    </view>

    <view class="meal">
      <view class="meal-label">🌅 早餐</view>
      <view class="meal-text">{{item.breakfast}}</view>
    </view>
    <view class="meal">
      <view class="meal-label">☀️ 午餐</view>
      <view class="meal-text">{{item.lunch}}</view>
    </view>
    <view class="meal">
      <view class="meal-label">🌙 晚餐</view>
      <view class="meal-text">{{item.dinner}}</view>
    </view>
    <view class="meal">
      <view class="meal-label">🍪 加餐</view>
      <view class="meal-text">{{item.snack}}</view>
    </view>
  </view>

  <!-- 补气血食材清单 -->
  <view class="card">
    <view class="section-title">补气血重点食材 ★</view>
    <view class="tag-list">
      <view class="tag tag-red">猪肝</view>
      <view class="tag tag-red">红枣</view>
      <view class="tag tag-red">桂圆</view>
      <view class="tag tag-red">桑葚</view>
      <view class="tag tag-red">黑芝麻</view>
      <view class="tag tag-red">枸杞</view>
      <view class="tag">牛肉</view>
      <view class="tag">菠菜</view>
      <view class="tag">黑木耳</view>
      <view class="tag">桂圆</view>
    </view>
    <view class="tip">💡 猪肝每周1-2次（补血首选）；菠菜先焯水去草酸</view>
  </view>
</view>
