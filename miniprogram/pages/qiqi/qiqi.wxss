.hero {
  background: linear-gradient(135deg, #D98C8C, #E8B4B4);
  color: #fff;
}
.hero-title { font-size: 36rpx; font-weight: bold; }
.hero-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.hero-count { font-size: 28rpx; margin-top: 16rpx; font-weight: bold; }

.qiqi-card { padding: 28rpx; }
.qiqi-done { opacity: 0.55; }
.qiqi-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.qiqi-main {
  display: flex;
  align-items: center;
}
.qiqi-icon { font-size: 46rpx; margin-right: 20rpx; }
.qiqi-title { font-size: 32rpx; font-weight: bold; color: var(--text); }
.qiqi-time { font-size: 24rpx; color: var(--pink); margin-top: 4rpx; }

.qiqi-check {
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid var(--pink);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #fff;
  flex-shrink: 0;
}
.qiqi-check.checked { background: var(--pink); }

.qiqi-desc {
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin: 18rpx 0;
  padding-left: 66rpx;
}
.qiqi-steps {
  background: #FDF6F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
}
.steps-title { font-size: 26rpx; font-weight: bold; color: var(--pink); margin-bottom: 10rpx; }
.step-item { font-size: 27rpx; color: var(--text); line-height: 1.9; }
.expand-hint { font-size: 24rpx; color: var(--text-sub); padding-left: 66rpx; margin-top: 4rpx; }

.explain { font-size: 28rpx; color: var(--text); line-height: 1.8; }
.hl { color: var(--pink); font-weight: bold; }
