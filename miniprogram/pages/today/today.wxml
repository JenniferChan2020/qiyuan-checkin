<view class="container">

  <!-- 顶部状态卡 -->
  <view class="card hero">
    <view class="hero-top">
      <view>
        <view class="hero-date">{{today}}</view>
        <view class="hero-title">元气修复 · 今日打卡</view>
      </view>
      <view class="hero-streak">
        <view class="streak-num">{{streak}}</view>
        <view class="streak-label">连续天数🔥</view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-wrap">
      <view class="progress-bar" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="progress-text">{{doneCount}}/{{tasks.length}} 已完成 · {{progressPercent}}%</view>

    <view class="motto">💬 {{motto}}</view>
  </view>

  <!-- 任务列表（按分类分组） -->
  <view wx:for="{{categories}}" wx:key="name" class="cat-block">
    <view class="cat-header">
      <text class="cat-emoji">{{item.emoji}}</text>
      <text class="cat-name">{{item.name}}</text>
    </view>
    <view
      wx:for="{{tasks}}" wx:for-item="task"
      wx:if="{{task.cat === item.key}}"
      wx:key="id"
      class="task-item {{task.done ? 'task-done' : ''}}"
      bindtap="toggleTask"
      data-id="{{task.id}}"
    >
      <view class="task-check {{task.done ? 'checked' : ''}}">
        <text wx:if="{{task.done}}">✓</text>
      </view>
      <text class="task-icon">{{task.icon}}</text>
      <text class="task-title">{{task.title}}</text>
    </view>
  </view>

</view>
