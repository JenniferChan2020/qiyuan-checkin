.hero {
  background: linear-gradient(135deg, #6B8E7B, #88B09E);
  color: #fff;
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.hero-date {
  font-size: 26rpx;
  opacity: 0.85;
}
.hero-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 6rpx;
}
.hero-streak {
  text-align: center;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
}
.streak-num {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}
.streak-label {
  font-size: 22rpx;
  opacity: 0.9;
}

.progress-wrap {
  height: 14rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 10rpx;
  margin: 24rpx 0 10rpx;
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  background: #fff;
  border-radius: 10rpx;
  transition: width 0.3s;
}
.progress-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}
.motto {
  margin-top: 20rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  line-height: 1.5;
}

.cat-block {
  margin-top: 8rpx;
}
.cat-header {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx 12rpx;
}
.cat-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}
.cat-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--green-dark);
}

.task-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  transition: all 0.2s;
}
.task-done {
  opacity: 0.5;
  background: #F0F7F2;
}
.task-check {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid var(--green);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.checked {
  background: var(--green);
}
.task-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.task-title {
  font-size: 30rpx;
  color: var(--text);
}
.task-done .task-title {
  text-decoration: line-through;
}
