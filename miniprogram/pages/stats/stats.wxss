.hero {
  background: linear-gradient(135deg, #6B8E7B, #88B09E);
}
.hero-grid {
  display: flex;
  justify-content: space-around;
}
.hero-item { text-align: center; color: #fff; }
.hero-num { font-size: 52rpx; font-weight: bold; line-height: 1.1; }
.hero-label { font-size: 24rpx; opacity: 0.9; margin-top: 6rpx; }

.today-bar-wrap {
  height: 24rpx;
  background: #EAF3EE;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 8rpx 0 12rpx;
}
.today-bar {
  height: 100%;
  background: linear-gradient(90deg, #6B8E7B, #88B09E);
  border-radius: 12rpx;
  transition: width 0.3s;
}
.today-text { font-size: 26rpx; color: var(--text-sub); }

.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 320rpx;
  padding: 20rpx 0 10rpx;
  border-bottom: 2rpx solid #eee;
}
.bar-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.bar-col {
  width: 44rpx;
  height: 240rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  position: relative;
  margin-bottom: 12rpx;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(0deg, #6B8E7B, #88B09E);
  border-radius: 8rpx;
  transition: height 0.5s;
  min-height: 4rpx;
}
.bar-num {
  position: absolute;
  top: -36rpx;
  font-size: 22rpx;
  color: var(--green-dark);
  font-weight: bold;
}
.bar-day { font-size: 22rpx; color: var(--text-sub); }
.chart-note { font-size: 22rpx; color: var(--text-sub); text-align: center; margin-top: 14rpx; }

.tip-card { background: #FDF6F6; }
.tip-text { font-size: 28rpx; color: var(--text); line-height: 1.7; }
